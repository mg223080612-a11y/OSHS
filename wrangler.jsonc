// Cloudflare Worker 설정 (사이트 이름 oshs)
// - 보통 파일은 그대로 내보내고, /api/* · /photos/* 만 worker/index.js 가 처리
// - KV 저장소 SHOWDAY : id 를 비워 두면 첫 배포 때 Cloudflare 가 자동으로 만들고 계속 그걸 씀
// - 비밀번호 ADMIN_KEY · PHOTO_KEY 는 여기 쓰지 말고 대시보드 → oshs → 설정 → 변수 및 비밀 에서 "비밀"로 추가
{
  "name": "oshs",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/photos/*"]
  },
  "kv_namespaces": [
    { "binding": "SHOWDAY" }
  ],
  "observability": { "enabled": true }
}
